df_encode=pd.get_dummies(df,drop_first=True)


df_encode


df_encode = df_encode.astype(int)
df_encode


from sklearn.preprocessing import StandardScaler


num_cols=['Age','RestingBP','Cholesterol','MaxHR','Oldpeak']
scaler=StandardScaler()
df_encode[num_cols]=scaler.fit_transform(df_encode[num_cols])


df_encode.head()





df_encode.columns


from scipy.stats import pearsonr

selection_features = ['Age', 'RestingBP', 'Cholesterol', 'FastingBS', 'MaxHR', 'Oldpeak',
        'Sex_M', 'ChestPainType_ATA', 'ChestPainType_NAP',
       'ChestPainType_TA', 'RestingECG_Normal', 'RestingECG_ST',
       'ExerciseAngina_Y', 'ST_Slope_Flat', 'ST_Slope_Up']
correlation ={
    features : pearsonr(df_encode[features],df_encode['HeartDisease'])[0]
    for features in selection_features
}

corr_df = pd.DataFrame(list(correlation.items()),columns=['features','Pearson Correlation'])
corr_df = corr_df.sort_values(by="Pearson Correlation",ascending=False)


corr_df


from scipy.stats import chi2_contingency

alpha = 0.05

chi2_results ={}

cat_features = ['Sex_M','ChestPainType_ATA','ChestPainType_NAP','ChestPainType_TA',
                'RestingECG_Normal','RestingECG_ST','ExerciseAngina_Y',
                'ST_Slope_Flat','ST_Slope_Up']

for col in cat_features:
    contingency = pd.crosstab(df_encode[col],df_encode['HeartDisease'])
    chi2_stats,p_val, _, _ = chi2_contingency(contingency)
    decision = 'Reject Null (Keep Features)' if p_val<alpha else 'Accept Bull (Drop Features)'
    chi2_results[col]={
        'chi_statstics':chi2_stats,
        'p_value':p_val,
        'Decision':decision
    }

chi2_df=pd.DataFrame(chi2_results).T
chi2_df = chi2_df.sort_values(by='p_value')
    



chi2_df


