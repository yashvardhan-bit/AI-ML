import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
import warnings

warnings.filterwarnings('ignore') # ignore warnings


df = pd.read_csv("insurance.csv")


df.head()





df.shape


df.info()


df.describe()


df.isnull().sum()


df.columns


numeric_cols = ['age','bmi','children','charges']
for cols in numeric_cols:
    plt.figure(figsize=(6,4))
    sns.histplot(df[cols],kde=True,bins=20)


sns.countplot(x=df['children'])


sns.countplot(x=df['sex'])


sns.countplot(x=df['smoker'])


for cols in numeric_cols:
    plt.figure(figsize=(6,4))
    sns.boxplot(x=df[cols])


plt.figure(figsize=(8,6))
sns.heatmap(df.corr(numeric_only=True),annot=True)





df_cleaned = df.copy()


df_cleaned.head()


df_cleaned.drop_duplicates(inplace=True)


df_cleaned.shape


df_cleaned.isnull().sum()


df_cleaned.dtypes


df_cleaned['sex'].value_counts()


df_cleaned['sex'] = df_cleaned['sex'].map({"male":1,"female":0})


df_cleaned.head()


df_cleaned['smoker'].value_counts()


df_cleaned['smoker'] = df_cleaned['smoker'].map({"yes":1,"no":0})


df_cleaned.head()


df_cleaned.rename(columns={
    'sex':'is_male',
    'smoker':'is_smoker'
},inplace=True)


df_cleaned.head()


df_cleaned['region'].value_counts()


df_cleaned = pd.get_dummies(df_cleaned,columns=['region'],drop_first=True)


df_cleaned.head()


df_cleaned = df_cleaned.astype(int)


df_cleaned.info()





sns.histplot(df_cleaned['bmi'])


df_cleaned['bmi_cats'] = pd.cut(
    df_cleaned['bmi'],
    bins=[0,18.5,24.9,29.9,float('inf')],
    labels= ['underweight','normal','overweight','obese']
)


df_cleaned.head()


df_cleaned=pd.get_dummies(df_cleaned,columns=['bmi_cats'],drop_first=True)
df_cleaned.head()


df_cleaned = df_cleaned.astype(int)


df_cleaned.head()


df_cleaned.columns


from sklearn.preprocessing import StandardScaler


cols=['age','bmi','children']
scaler=StandardScaler()
df_cleaned[cols]=scaler.fit_transform(df_cleaned[cols])


df_cleaned.head()



